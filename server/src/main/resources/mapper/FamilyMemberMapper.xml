<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.genealogy.mapper.FamilyMemberMapper">

    <resultMap id="membershipResultMap" type="com.genealogy.domain.family.Membership">
        <constructor>
            <arg column="user_id" javaType="java.util.UUID" typeHandler="com.genealogy.config.MyBatisConfig$UUIDTypeHandler"/>
            <arg column="role" javaType="com.genealogy.domain.family.Role" typeHandler="com.genealogy.config.MyBatisConfig$RoleTypeHandler"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO family_members (family_id, user_id, role)
        VALUES (#{familyId}, #{userId}, #{role})
    </insert>

    <select id="findByFamilyAndUser" resultMap="membershipResultMap">
        SELECT user_id, role FROM family_members
        WHERE family_id = #{familyId} AND user_id = #{userId}
    </select>

    <select id="existsByFamilyAndUser" resultType="boolean">
        SELECT COUNT(*) > 0 FROM family_members
        WHERE family_id = #{familyId} AND user_id = #{userId}
    </select>

    <delete id="deleteAll">
        DELETE FROM family_members
    </delete>

</mapper>
