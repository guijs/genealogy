<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.genealogy.mapper.FamilyMapper">

    <resultMap id="familyResultMap" type="com.genealogy.domain.family.Family">
        <constructor>
            <idArg column="id" javaType="java.util.UUID" typeHandler="com.genealogy.config.MyBatisConfig$UUIDTypeHandler"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="progenitor_person_id" javaType="java.util.UUID" typeHandler="com.genealogy.config.MyBatisConfig$UUIDTypeHandler"/>
            <arg column="generation_names" javaType="java.util.List" typeHandler="com.genealogy.config.MyBatisConfig$StringArrayTypeHandler"/>
            <arg column="generation_name_align" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO families (id, name)
        VALUES (#{id}, #{name})
    </insert>

    <select id="findById" resultMap="familyResultMap">
        SELECT id, name, progenitor_person_id, generation_names, generation_name_align FROM families WHERE id = #{id}
    </select>

    <select id="existsById" resultType="boolean">
        SELECT COUNT(*) > 0 FROM families WHERE id = #{id}
    </select>

    <update id="updateProgenitor">
        UPDATE families SET progenitor_person_id = #{progenitorPersonId} WHERE id = #{id}
    </update>

    <update id="updateGenerationNames">
        UPDATE families SET 
            generation_names = #{generationNames, typeHandler=com.genealogy.config.MyBatisConfig$StringArrayTypeHandler},
            generation_name_align = #{generationNameAlign}
        WHERE id = #{id}
    </update>

    <delete id="deleteAll">
        DELETE FROM families
    </delete>

</mapper>
