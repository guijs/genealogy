<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.genealogy.mapper.CommentPersonRefMapper">

    <resultMap id="personRefRowResultMap" type="com.genealogy.mapper.CommentPersonRefMapper$PersonRefRow">
        <constructor>
            <idArg column="id" javaType="java.util.UUID" typeHandler="com.genealogy.config.MyBatisConfig$UUIDTypeHandler"/>
            <arg column="comment_id" javaType="java.util.UUID" typeHandler="com.genealogy.config.MyBatisConfig$UUIDTypeHandler"/>
            <arg column="person_id" javaType="java.util.UUID" typeHandler="com.genealogy.config.MyBatisConfig$UUIDTypeHandler"/>
            <arg column="display_name_snapshot" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO comment_person_refs (id, comment_id, person_id, display_name_snapshot)
        VALUES (#{id}, #{commentId}, #{personId}, #{displayNameSnapshot})
    </insert>

    <select id="findByCommentId" resultMap="personRefRowResultMap">
        SELECT id, comment_id, person_id, display_name_snapshot, created_at
        FROM comment_person_refs
        WHERE comment_id = #{commentId}
        ORDER BY created_at ASC
    </select>

    <select id="findByCommentIds" resultMap="personRefRowResultMap">
        <if test="commentIds != null and commentIds.size() > 0">
            SELECT id, comment_id, person_id, display_name_snapshot, created_at
            FROM comment_person_refs
            WHERE comment_id IN
            <foreach collection="commentIds" item="commentId" open="(" separator="," close=")">
                #{commentId}
            </foreach>
            ORDER BY comment_id, created_at ASC
        </if>
    </select>

    <delete id="deleteByCommentId">
        DELETE FROM comment_person_refs WHERE comment_id = #{commentId}
    </delete>

    <delete id="deleteAll">
        DELETE FROM comment_person_refs
    </delete>

</mapper>
