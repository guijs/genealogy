# 家族图 API 切换（默认 mock fixture）
# false / 未设置 → 使用本地 fixture（MOCK / 待换真 API）
# true → 请求真 GET /api/v1/families/{familyId}/graph
VITE_USE_GRAPH_API=false

# 真 API 基址（可选）。设置非空也会切换到真 API。
# 留空 = 同源相对路径，例如 /api/v1/...
# 示例：http://localhost:8080
VITE_GRAPH_API_BASE=

# 真 API 认证用户 ID（使用真 API 时必须设置）
# 值为 family member UUID，发送为 X-User-Id header
# 示例：123e4567-e89b-12d3-a456-426614174000
VITE_GRAPH_USER_ID=
