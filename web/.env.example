# 家族图 API 切换（默认 mock fixture）
# false / 未设置 → 使用本地 fixture（MOCK / 待换真 API）
# true → 请求真 GET /api/v1/families/{familyId}/graph
VITE_USE_GRAPH_API=false

# 真 API 基址（可选）。设置非空也会切换到真 API。
# 留空 = 同源相对路径，例如 /api/v1/...
# 示例：http://localhost:8080
VITE_GRAPH_API_BASE=

# ============================================================
# 本地开发连接后端的两种方式
# ============================================================
#
# 方式 A：直连后端（依赖后端 CORS 配置）
#   VITE_USE_GRAPH_API=true
#   VITE_GRAPH_API_BASE=http://localhost:8080
#
#   说明：前端直接请求 http://localhost:8080，后端已配置 CORS
#   允许来自 localhost:5173/5174 的跨域请求。
#
# 方式 B：通过 Vite 代理（同源代理，无需 CORS）
#   VITE_USE_GRAPH_API=true
#   VITE_GRAPH_API_BASE=
#
#   说明：VITE_GRAPH_API_BASE 留空，请求走 /api/... 相对路径，
#   由 vite.config.ts 中配置的 proxy 转发到 http://localhost:8080。
#   此方式避免浏览器 CORS 检查，适合后端 CORS 不可用的情况。
#
# ============================================================

# @deprecated — 此变量已废弃，运行时不读取。
# 认证现通过 JWT token 实现：登录后 token 存储在 localStorage，
# 前端自动发送 Authorization: Bearer <token> header。
# VITE_GRAPH_USER_ID=
